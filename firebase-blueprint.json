{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for authentication and role management.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["donor", "requester", "admin"] },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role"]
    },
    "Donor": {
      "title": "Donor",
      "description": "Public privacy-safe donor profile searchable by seekers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "age": { "type": "number" },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "approximateDistanceKm": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "lastDonationDate": { "type": "string" },
        "lastVerifiedDate": { "type": "string" },
        "donationCount": { "type": "number" },
        "preferredDonationCenters": { "type": "string" },
        "contactPreference": { "type": "string", "enum": ["In-App Notification", "SMS via Platform", "Authorized Hospital Only"] },
        "status": { "type": "string", "enum": ["Active", "Suspended", "Unavailable"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "bloodGroup", "city", "isAvailable"]
    },
    "BloodRequest": {
      "title": "BloodRequest",
      "description": "Blood donation request created by patients or hospital seekers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string", "maxLength": 50 },
        "requesterId": { "type": "string" },
        "requesterName": { "type": "string", "maxLength": 100 },
        "requesterPhone": { "type": "string", "maxLength": 30 },
        "requesterEmail": { "type": "string", "format": "email" },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "unitsRequired": { "type": "number" },
        "hospitalName": { "type": "string", "maxLength": 150 },
        "hospitalAddress": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "requiredDate": { "type": "string" },
        "requiredTime": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Normal", "Urgent"] },
        "additionalNotes": { "type": "string", "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["Pending Verification", "Urgent - Pending Verification", "Verified", "Matching", "Donor Contacted", "Fulfilled", "Cancelled"]
        },
        "matchedDonorCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bloodGroup", "unitsRequired", "hospitalName", "city", "urgency", "status"]
    },
    "DonorRequest": {
      "title": "DonorRequest",
      "description": "Coordination link between a blood request and an invited donor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "donorId": { "type": "string" },
        "requesterId": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "hospitalName": { "type": "string" },
        "units": { "type": "number" },
        "status": { "type": "string", "enum": ["New", "Accepted", "Declined", "Completed", "Cancelled"] },
        "message": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "donorId", "requesterId", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications for donors, requesters and administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["request", "status", "verification", "alert"] },
        "isRead": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Historical record of past blood donations for a donor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "donorId": { "type": "string" },
        "donationDate": { "type": "string" },
        "donationCenter": { "type": "string", "maxLength": 150 },
        "units": { "type": "number" },
        "bloodGroup": { "type": "string" },
        "status": { "type": "string", "enum": ["Completed", "Scheduled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["donorId", "donationDate", "donationCenter", "status"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Audit trail of admin operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with role and preferences."
    },
    "/donors/{donorId}": {
      "schema": { "$ref": "#/entities/Donor" },
      "description": "Privacy-safe donor profiles for search and matching."
    },
    "/bloodRequests/{requestId}": {
      "schema": { "$ref": "#/entities/BloodRequest" },
      "description": "Coordination requests for blood needs."
    },
    "/donorRequests/{donorRequestId}": {
      "schema": { "$ref": "#/entities/DonorRequest" },
      "description": "Requests routed to specific donors."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notification messages."
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Past donations records."
    },
    "/adminLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Administrative actions audit log."
    }
  }
}
